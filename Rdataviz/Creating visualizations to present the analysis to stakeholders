6 - Heatmap - Heatmap of Rides by Hour and User Type – Combined Data

# Install and load required packages
install.packages("tidyverse")   # if not already installed
install.packages("geosphere")   # for haversine distance calculation

library(tidyverse)              # main data science package
library(lubridate)              # for working with dates and times
library(readr)                  # for reading CSV files
library(ggplot2)                # for creating visualizations
library(dplyr)                  # for data manipulation
library(geosphere)              # for calculating distances

# Read the CSV files
march <- read_csv("march.csv")
april <- read_csv("april.csv")
may   <- read_csv("may.csv")

# Create 'hour' column for each dataset
march_data <- march %>% mutate(hour = hour(started_at))
april_data <- april %>% mutate(hour = hour(started_at))
may_data   <- may   %>% mutate(hour = hour(started_at))

# Aggregate ride counts by hour and user type
march_heatmap <- march_data %>%
  group_by(hour, member_casual) %>%
  summarise(rides = n(), .groups = "drop")

april_heatmap <- april_data %>%
  group_by(hour, member_casual) %>%
  summarise(rides = n(), .groups = "drop")

may_heatmap <- may_data %>%
  group_by(hour, member_casual) %>%
  summarise(rides = n(), .groups = "drop")

# Define a plotting function for monthly heatmaps
plot_monthly <- function(data, month_name) {
  ggplot(data, aes(x = hour, y = member_casual, fill = rides)) +
    geom_tile(color = "white") +
    scale_fill_gradient(low = "#f0f9e8", high = "#084081") +
    labs(
      title = paste("Heatmap of Rides by Hour –", month_name),
      x = "Hour of Day",
      y = "User Type",
      fill = "Number of Rides"
    ) +
    theme_minimal(base_size = 14) +
    theme(
      panel.grid = element_blank(),
      axis.text.y = element_text(face = "bold"),
      plot.title = element_text(face = "bold", hjust = 0.5)
    )
}

# Generate monthly heatmaps
plot_monthly(march_heatmap, "March")
plot_monthly(april_heatmap, "April")
plot_monthly(may_heatmap, "May")

# Combine all datasets into one
all_data <- bind_rows(march, april, may)

# Clean and transform the data
all_data <- all_data %>%
  mutate(
    started_at     = ymd_hms(started_at),
    ended_at       = ymd_hms(ended_at),
    hour           = hour(started_at),
    duration       = as.numeric(difftime(ended_at, started_at, units = "mins")),
    member_casual  = tolower(member_casual)
  )

# Calculate distance
if (all(c("start_lng", "start_lat", "end_lng", "end_lat") %in% names(all_data))) {
  all_data <- all_data %>%
    mutate(
      distance = distHaversine(
        cbind(start_lng, start_lat),
        cbind(end_lng, end_lat)
      ) / 1000  # convert meters to kilometers
    )
} else if (!"distance" %in% names(all_data)) {
  stop("Distance columns or lat/lng not found. Please adjust your dataset.")
}

# Final heatmap using combined data
combined_heatmap <- all_data %>%
  group_by(hour, member_casual) %>%
  summarise(rides = n(), .groups = "drop")

ggplot(combined_heatmap, aes(x = hour, y = member_casual, fill = rides)) +
  geom_tile(color = "white") +
  scale_fill_gradient(low = "#f0f9e8", high = "#084081") +
  labs(
    title = "Heatmap of Rides by Hour and User Type – Combined Data",
    x = "Hour of Day",
    y = "User Type",
    fill = "Number of Rides"
  ) +
  theme_minimal(base_size = 14) +
  theme(
    panel.grid = element_blank(),
    axis.text.y = element_text(face = "bold"),
    plot.title = element_text(face = "bold", hjust = 0.5)
  )
