5 - Cook County map - "Top 3 Most Used Stations by Group – Chicago" and "Top 10 Most Used Stations by Group – Chicago"

# Install required packages
install.packages(c("data.table", "ggplot2", "maps", "ggrepel"))

# Load libraries
library(data.table)
library(ggplot2)
library(maps)
library(ggrepel)

# List of files
files <- c("march.csv", "april.csv", "may.csv")

# Essential columns
cols <- c("member_casual", "start_station_name", "start_lat", "start_lng")

# Efficient reading and stacking
bike_data <- rbindlist(
  lapply(files, function(f) fread(f, select = cols)),
  use.names = TRUE
)

# Standardize user groups
bike_data[, member_casual := tolower(member_casual)]

# Count number of rides per station and user type
station_counts <- bike_data[
  , .(rides = .N, lat = first(start_lat), lng = first(start_lng)),
  by = .(start_station_name, member_casual)
]

# Select the top 3 most used stations per group
top_stations <- station_counts[
  order(-rides),
  .SD[1:3],
  by = member_casual
]

# Cook County map
cook_map <- map_data("county", "illinois")[
  map_data("county", "illinois")$subregion == "cook", ]

# Plot with basic labels
ggplot() +
  geom_polygon(
    data = cook_map,
    aes(x = long, y = lat, group = group),
    fill  = "grey95",
    color = "white"
  ) +
  geom_point(
    data = top_stations,
    aes(x = lng, y = lat, size = rides, color = member_casual),
    alpha = 0.8
  ) +
  geom_text(
    data = top_stations,
    aes(x = lng, y = lat, label = start_station_name),
    size = 3,
    nudge_y = 0.002,
    check_overlap = TRUE
  ) +
  scale_color_manual(
    values = c("member" = "steelblue", "casual" = "tomato"),
    labels = c("Members", "Casuals")
  ) +
  scale_size_continuous(range = c(4, 10)) +
  labs(
    title    = "Top 3 Most Used Stations by Group – Chicago",
    subtitle = "Data from March, April, and May 2025",
    color    = "User Type",
    size     = "Number of Rides"
  ) +
  theme_void(base_size = 14) +
  theme(
    legend.position = "bottom",
    plot.title      = element_text(face = "bold", size = 16),
    plot.subtitle   = element_text(size = 11)
  )

  # Select the top 10 most used stations per group
top_stations <- station_counts[
  order(-rides),
  .SD[1:10],
  by = member_casual
]

# Plot with adjusted labels
ggplot() +
  geom_polygon(
    data = cook_map,
    aes(x = long, y = lat, group = group),
    fill  = "grey95",
    color = "white"
  ) +
  geom_point(
    data = top_stations,
    aes(x = lng, y = lat, size = rides, color = member_casual),
    alpha = 0.8
  ) +
  geom_text(
    data = top_stations,
    aes(x = lng, y = lat, label = start_station_name),
    size = 3,
    hjust = 0.5, vjust = -1,
    check_overlap = TRUE
  ) +
  scale_color_manual(
    values = c("member" = "#1f78b4", "casual" = "#e31a1c"),
    labels = c("Member", "Casual")
  ) +
  scale_size_continuous(
    range = c(3, 8),
    breaks = c(100, 500, 1000),
    labels = c("100", "500", "1000+")
  ) +
  labs(
    title    = "Top 3 Most Used Stations by Group – Chicago",
    subtitle = "Data from March, April, and May",
    color    = "User",
    size     = "Rides"
  ) +
  theme_void(base_size = 12) +
  theme(
    legend.position = "bottom",
    legend.title    = element_text(size = 10),
    legend.text     = element_text(size = 9),
    plot.title      = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle   = element_text(size = 10, hjust = 0.5)
  )

# Plot with ggrepel labels
ggplot() +
  geom_polygon(
    data = cook_map,
    aes(x = long, y = lat, group = group),
    fill  = "grey95",
    color = "white"
  ) +
  geom_point(
    data = top_stations,
    aes(x = lng, y = lat, size = rides, color = member_casual),
    alpha = 0.8
  ) +
  geom_text_repel(
    data = top_stations,
    aes(x = lng, y = lat, label = start_station_name),
    size = 3,
    max.overlaps = 30,
    box.padding = 0.4,
    segment.color = "grey30",
    segment.size = 0.5
  ) +
  scale_color_manual(
    values = c("member" = "#1f78b4", "casual" = "#e31a1c"),
    labels = c("Member", "Casual")
  ) +
  scale_size_continuous(
    range = c(3, 8),
    breaks = c(100, 500, 1000),
    labels = c("100", "500", "1000+")
  ) +
  labs(
    title    = "Top 10 Most Used Stations by Group – Chicago",
    subtitle = "Data from March, April, and May",
    color    = "User",
    size     = "Rides"
  ) +
  theme_void(base_size = 12) +
  theme(
    legend.position = "bottom",
    legend.title    = element_text(size = 9),
    legend.text     = element_text(size = 8),
    plot.title      = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.subtitle   = element_text(size = 10, hjust = 0.5)
  )

# Save image
