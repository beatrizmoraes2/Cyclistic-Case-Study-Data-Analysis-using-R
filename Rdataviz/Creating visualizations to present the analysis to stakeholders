1 - Bar Chart Viz - Monthly Ride Volume: Casual vs. Members

#Install and load tidyverse

install.packages("tidyverse")
library(tidyverse)

# Path to the folder containing the files
path <- "Cyclistic Spreadsheets"

# List of .csv files in the folder
files <- list.files(path = path, pattern = "*.csv", full.names = TRUE)

# Function to read each file and add the month name
combined_data <- files %>%
  map_df(~ read_csv(.x) %>%
           mutate(month = tools::file_path_sans_ext(basename(.x))))

# Check if the data was combined correctly
glimpse(combined_data)

# Load ggplot2 package
library(ggplot2)

# Define the correct order of months
month_order <- c("january", "february", "march", "april", "may")

# Convert 'month' column to ordered factor
cyclistic_data <- combined_data %>%
  mutate(month = factor(month, levels = month_order))

# Create bar chart visualization
ggplot(cyclistic_data, aes(x = month, fill = member_casual)) +
  geom_bar(position = "dodge") +
  labs(title = "Monthly Ride Volume: Casual vs. Members",
       x = "Month",
       y = "Number of Rides",
       fill = "User Type") +
  theme_minimal()

2 - Line Chart - Monthly Ride Trends: Casual vs. Members

# Prepare aggregated data
aggregated_data <- cyclistic_data %>%
  group_by(month, member_casual) %>%
  summarise(ride_count = n(), .groups = "drop")

# Ensure months are in correct order
month_order <- c("january", "february", "march", "april", "may")

aggregated_data <- aggregated_data %>%
  mutate(month = factor(month, levels = month_order))

# Load package
library(scales)

# Create line chart
ggplot(aggregated_data, aes(x = month, y = ride_count, color = member_casual, group = member_casual)) +
  geom_line(size = 1.2) +
  geom_point(size = 3) +
  scale_y_continuous(labels = label_comma()) +
  labs(title = "Monthly Ride Trends: Casual vs. Members",
       x = "Month",
       y = "Number of Rides",
       color = "User Type") +
  theme_minimal()

